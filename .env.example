# Primary LLM — OpenAI
OPENAI_API_KEY=

# Fallback LLM — Groq (used when OpenAI is unavailable; free tier at console.groq.com)
GROQ_API_KEY=

# HuggingFace — authenticated downloads (higher rate limits, suppresses warning)
# Get a free read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Session store — Redis URL for persistent conversations across restarts.
# Leave unset to use the in-memory fallback (conversations lost on restart).
REDIS_URL=redis://localhost:6379/0

# Conversation TTL in seconds (default: 86400 = 24 hours). Requires REDIS_URL.
# CONV_TTL_SECONDS=86400

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO

# LangSmith observability — set LANGCHAIN_API_KEY to activate tracing.
# All LLM calls will appear in the LangSmith dashboard automatically.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hotel-assistant

# Prompt variant to pull from LangSmith Hub at server startup (default: latest).
# After pushing prompts with scripts/push_prompts.py, tag a commit in the Hub UI
# and set this to that tag (e.g. v1, v2) to pin a specific version.
# Leave unset or set to "latest" to always use the most recent Hub version.
# Has no effect when LANGCHAIN_API_KEY is not set (hardcoded defaults are used).
PROMPT_VARIANT=latest
